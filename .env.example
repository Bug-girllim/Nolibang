# =====================================================================
# 놀이방 LMS · 환경변수 예시 (값은 모두 예시 — 실제 비밀번호·키를 이 파일에 적어 커밋하지 마세요)
#
# 주의: 이 앱은 .env 파일을 자동으로 읽지 않습니다.
#       필요한 값만 셸(PowerShell: $env:이름="값") 또는 IntelliJ 실행 설정(Environment variables)에 넣으세요.
#       아래 값을 하나도 넣지 않아도, 로컬 MySQL에 nolibang DB와 wanted/wanted 계정이 있으면 그대로 실행됩니다.
#       (기본값 출처: src/main/resources/application.yaml)
# =====================================================================

# ---------------------------------------------------------------------
# [선택] 로컬 DB 접속 — 기본 프로필(프로필 지정 없음)에서 사용. 비우면 아래 기본값.
# ---------------------------------------------------------------------
# LOCAL_DB_URL=jdbc:mysql://localhost:3306/nolibang?characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
# LOCAL_DB_USERNAME=wanted
# LOCAL_DB_PASSWORD=wanted

# ---------------------------------------------------------------------
# [선택] 이메일 인증 메일 실제 발송 (Gmail SMTP)
#   비우면 메일을 보내지 않고 서버 로그에 "[개발용] SMTP가 설정되지 않아 ... 링크:" 로 인증 링크를 출력합니다.
#   실제 발송이 필요하면 계정·앱 비밀번호를 별도로 전달받아 넣으세요.
# ---------------------------------------------------------------------
# MAIL_USERNAME=
# MAIL_PASSWORD=

# ---------------------------------------------------------------------
# [선택] 메일 속 링크의 주소. 기본 http://localhost:8080
# ---------------------------------------------------------------------
# APP_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------
# [선택] 업로드 파일 저장 — 기본은 프로젝트 폴더의 ./uploads (시드 이미지·강의 영상 포함)
#   FILE_STORAGE=s3 일 때만 S3_* 값이 쓰입니다. 제출 실행에는 필요 없습니다.
# ---------------------------------------------------------------------
# FILE_STORAGE=local
# UPLOAD_DIR=./uploads
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ---------------------------------------------------------------------
# [선택] 회원 탈퇴 시 이메일 확인값(해시) 키 — 비우면 개발용 기본 키. 운영 배포 때만 별도 값 사용.
# ---------------------------------------------------------------------
# WITHDRAWAL_EMAIL_HASH_KEY=

# ---------------------------------------------------------------------
# [선택] HTTPS·프록시 뒤에서 배포할 때만 (로컬 실행에는 필요 없음)
# ---------------------------------------------------------------------
# SESSION_COOKIE_SECURE=false
# FORWARD_HEADERS_STRATEGY=none

# ---------------------------------------------------------------------
# [제출 실행에는 사용하지 않음] prod / shared 프로필 전용 DB 접속
#   SPRING_PROFILES_ACTIVE=prod 또는 shared 일 때만 읽습니다. 팀 공용 DB 접속 정보는 Git에 올리지 않습니다.
# ---------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=
# DB_URL=
# DB_USERNAME=
# DB_PASSWORD=
